{
  "manifest_version": 3,
  "name": "TB Active Receiver (standalone)",
  "version": "1.0.3",
  "description": "__MSG_extensionDescription__",
  "author": "markbai",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "tb_active_receiver_standalone@markbai.thunderbird.local",
      "strict_min_version": "128.0",
      "update_url": "https://raw.githubusercontent.com/Mark-Fridge-Channels/ThunderbirdExtension/main/updates.json"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "action/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "permissions": [
    "accountsRead",
    "alarms",
    "messagesRead",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "experiment_apis": {
    "receiver": {
      "schema": "api/receiver/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "receiver"
          ]
        ],
        "script": "api/receiver/implementation.js"
      }
    }
  }
}
