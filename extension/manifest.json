{
  "manifest_version": 3,
  "name": "Mail Automation Agent",
  "version": "1.0.0",
  "description": "Local email automation: receive commands via local HTTP server (127.0.0.1:3939) and execute Thunderbird API actions.",
  "author": "markbai",
  "browser_specific_settings": {
    "gecko": {
      "id": "mail_automation_agent@markbai.thunderbird.local",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background/background.js"],
    "type": "module"
  },
  "permissions": [
    "alarms",
    "accountsRead",
    "messagesRead",
    "messagesUpdate",
    "compose",
    "compose.send",
    "addressBooks",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3939/*"
  ],
  "optional_permissions": [
    "compose.save"
  ],
  "default_locale": "en"
}
